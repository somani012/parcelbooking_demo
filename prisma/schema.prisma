generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum EntityStatus {
  ACTIVE
  DISABLED
}

enum ShipmentType {
  DOCUMENT
  PARCEL
  LETTER
  OTHER
}

enum BookingStatus {
  DRAFT
  BOOKED
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  PAYMENT_RECEIVED
  BOOKING_DEDUCTION
  REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String       @unique
  passwordHash String       @map("password_hash")
  role         Role
  clientId     String?      @map("client_id")
  client       Client?      @relation(fields: [clientId], references: [id])
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("users")
}

model Client {
  id            String        @id @default(cuid())
  clientCode    String        @unique @map("client_code")
  companyName   String        @map("company_name")
  contactPerson String        @map("contact_person")
  email         String        @unique
  phone         String
  address       String
  city          String
  state         String
  pinCode       String        @map("pin_code")
  gstNumber     String?       @map("gst_number")
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  status        EntityStatus  @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  users         User[]
  bookings      Booking[]
  payments      Payment[]
  transactions  Transaction[]

  @@map("clients")
}

model Booking {
  id               String        @id @default(cuid())
  bookingId        String        @unique @map("booking_id")
  clientId         String        @map("client_id")
  client           Client        @relation(fields: [clientId], references: [id])
  senderName       String        @map("sender_name")
  senderCompany    String?       @map("sender_company")
  senderMobile     String        @map("sender_mobile")
  senderAddress    String        @map("sender_address")
  senderCity       String        @map("sender_city")
  senderState      String        @map("sender_state")
  senderPin        String        @map("sender_pin")
  receiverName     String        @map("receiver_name")
  receiverCompany  String?       @map("receiver_company")
  receiverMobile   String        @map("receiver_mobile")
  receiverAddress  String        @map("receiver_address")
  receiverCity     String        @map("receiver_city")
  receiverState    String        @map("receiver_state")
  receiverPin      String        @map("receiver_pin")
  shipmentType     ShipmentType  @map("shipment_type")
  serviceId        String        @map("service_id")
  service          Service       @relation(fields: [serviceId], references: [id])
  weight           Decimal       @db.Decimal(8, 3)
  quantity         Int           @default(1)
  length           Decimal?      @db.Decimal(8, 2)
  width            Decimal?      @db.Decimal(8, 2)
  height           Decimal?      @db.Decimal(8, 2)
  description      String?
  trackingNumber   String?       @map("tracking_number")
  bookingDate      DateTime      @map("booking_date") @db.Date
  baseCharge       Decimal       @map("base_charge") @db.Decimal(10, 2)
  additionalCharge Decimal       @map("additional_charge") @db.Decimal(10, 2)
  gst              Decimal       @db.Decimal(10, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(10, 2)
  bookingStatus    BookingStatus @default(BOOKED) @map("booking_status")
  paymentStatus    String        @default("Paid from balance") @map("payment_status")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([clientId, createdAt])
  @@map("bookings")
}

model Payment {
  id              String        @id @default(cuid())
  paymentId       String        @unique @map("payment_id")
  clientId        String        @map("client_id")
  client          Client        @relation(fields: [clientId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  utrNumber       String        @unique @map("utr_number")
  paymentDate     DateTime      @map("payment_date") @db.Date
  screenshot      Bytes?
  screenshotMime  String?       @map("screenshot_mime")
  status          PaymentStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  approvedBy      String?       @map("approved_by")
  approvedAt      DateTime?     @map("approved_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@map("payments")
}

model Transaction {
  id              String          @id @default(cuid())
  transactionId   String          @unique @map("transaction_id")
  clientId        String          @map("client_id")
  client          Client          @relation(fields: [clientId], references: [id])
  transactionType TransactionType @map("transaction_type")
  amount          Decimal         @db.Decimal(12, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(12, 2)
  referenceId     String?         @map("reference_id")
  description     String?
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@map("transactions")
}

model Service {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  status       EntityStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  pricingRules PricingRule[]
  bookings     Booking[]

  @@map("services")
}

model PricingRule {
  id              String       @id @default(cuid())
  serviceId       String       @map("service_id")
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  minimumWeight   Decimal      @map("minimum_weight") @db.Decimal(8, 3)
  maximumWeight   Decimal      @map("maximum_weight") @db.Decimal(8, 3)
  basePrice       Decimal      @map("base_price") @db.Decimal(10, 2)
  additionalPrice Decimal      @default(0) @map("additional_price") @db.Decimal(10, 2)
  status          EntityStatus @default(ACTIVE)

  @@map("pricing_rules")
}

model CompanySettings {
  id            Int     @id @default(1)
  companyName   String  @default("Shree Parcel Services") @map("company_name")
  logo          Bytes?
  logoMime      String? @map("logo_mime")
  address       String  @default("")
  phone         String  @default("")
  email         String  @default("")
  gstNumber     String? @map("gst_number")
  gstPercent    Decimal @default(18) @map("gst_percent") @db.Decimal(5, 2)
  upiId         String  @default("") @map("upi_id")
  bankName      String  @default("") @map("bank_name")
  accountName   String  @default("") @map("account_name")
  accountNumber String  @default("") @map("account_number")
  ifsc          String  @default("")
  branch        String  @default("")
  terms         String  @default("")

  @@map("company_settings")
}

model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
